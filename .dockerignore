# Session/cache data written by the wa-bridge container (owned by pptruser UID).
# Excluding these prevents Podman/Docker from failing to stat them during build.
tools/wa-real-bridge/.wwebjs_auth
tools/wa-real-bridge/.wwebjs_cache
tools/wa-real-bridge/node_modules
tools/wa-real-bridge/instances.json

# Dev/test artefacts that don't belong in the web image.
htmlcov
coverage.xml
.git
tests
*.md
