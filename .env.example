# Copy to .env and adjust as needed: cp .env.example .env

# Flask
SECRET_KEY=change-me
APP_TIMEZONE=Asia/Jakarta
WHATSAPP_MODE=bridge
WA_BRIDGE_IGNORE_CERT_ERRORS=true
# Password for the first-run seeded admin account. Only applied when the
# admin user is first created - has no effect on existing accounts.
# Leave empty to force random one-time passwords at bootstrap.
SEED_ADMIN_PASSWORD=admin123

# Postgres (used by docker-compose's db service; web's DATABASE_URL is
# derived from these automatically when running via docker-compose)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking123
POSTGRES_DB=booking

# Only needed for non-Docker runs (docker-compose sets this itself)
# DATABASE_URL=sqlite:///detailing.db

# WhatsApp bridge (tools/wa-real-bridge) - legacy, being replaced by OpenWA
FORWARD_GROUPS=false

# ---------------------------------------------------------------------------
# OpenWA gateway (replaces the wa-real-bridge)
# ---------------------------------------------------------------------------
# Root API key the Flask app authenticates with, sent as the X-API-Key header.
# Generate with: openssl rand -hex 32
OPENWA_API_KEY=change-me-openssl-rand-hex-32
# Pepper used to hash API keys at rest. Changing it invalidates every issued key.
# Generate with: openssl rand -hex 32
OPENWA_API_KEY_PEPPER=change-me-openssl-rand-hex-32

# Shared secret for verifying inbound webhooks. OpenWA signs each delivery as
# X-OpenWA-Signature: sha256=<hmac>, and Flask rejects anything that fails.
# This is what stops /api/whatsapp/inbound accepting forged bookings.
# Generate with: openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# Where the Flask app reaches the gateway (compose service name).
OPENWA_BASE_URL=http://openwa:2785
# Session name inside OpenWA. One number = one session.
OPENWA_SESSION_ID=default

# Engine: blank = whatsapp-web.js (headless Chromium, heavier, lower
# fingerprinting profile). Set to `baileys` for a browser-free socket client.
# Switching engines requires re-linking the number.
OPENWA_ENGINE=
# Blank auto-pins a settled WhatsApp Web build from wppconnect's wa-version
# registry. Set `off` to always use whatever WhatsApp serves, or an exact build.
OPENWA_WWEBJS_WEB_VERSION=
OPENWA_LOG_LEVEL=info
# OpenWA refuses webhook targets on private addresses by default. The Flask
# service is one, so its hostname has to be allowlisted explicitly.
OPENWA_SSRF_ALLOWED_HOSTS=web
