# Copy to .env and adjust as needed: cp .env.example .env

# Flask
SECRET_KEY=change-me
APP_TIMEZONE=Asia/Jakarta
WHATSAPP_MODE=mock

# Passwords for the first-run seed accounts (admin/cs1/tech1). Only applied
# when each user is first created - has no effect on existing accounts.
# If unset, insecure hardcoded defaults are used and a warning is logged.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_CS_PASSWORD=change-me-cs
SEED_TECH_PASSWORD=change-me-tech

# Postgres (used by docker-compose's db service; web's DATABASE_URL is
# derived from these automatically when running via docker-compose)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Only needed for non-Docker runs (docker-compose sets this itself)
# DATABASE_URL=sqlite:///detailing.db

# WhatsApp bridge (tools/wa-real-bridge)
FORWARD_GROUPS=false
